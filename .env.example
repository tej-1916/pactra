# PACTRA - placeholders only

DATABASE_URL=postgresql+asyncpg://pactra:pactra@localhost:5432/pactra
REDIS_URL=redis://localhost:6379/0

# Razorpay TEST MODE ONLY
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
# Every provider call also has a 10s overall wall-clock bound. These phase
# bounds prevent a stalled connect/read/write/pool wait from holding the
# PaymentIntent transaction indefinitely.
RAZORPAY_CONNECT_TIMEOUT_SECONDS=3
RAZORPAY_READ_TIMEOUT_SECONDS=7
RAZORPAY_WRITE_TIMEOUT_SECONDS=5
RAZORPAY_POOL_TIMEOUT_SECONDS=2
RAZORPAY_OVERALL_TIMEOUT_SECONDS=10

# LOCAL CRYPTOGRAPHIC APPROVAL PROOF demo trust root. Public key only.
# Generate the DEMO USER-CONTROLLED SIGNING KEY outside the server with the
# local signer utility; never place its private key in this file or repository.
DEMO_APPROVER_SIGNING_KEY_ID=demo-user-ed25519-v1
DEMO_APPROVER_PUBLIC_KEY_HEX=

# LLM provider - optional until later phase
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
