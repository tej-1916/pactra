# PACTRA console — server-side only. NEVER prefix these with NEXT_PUBLIC_.
#
# The console holds no credentials of its own. It reads the PACTRA API and
# reads generated benchmark reports from disk. There is no secret here, and
# none should ever be added: a value that reaches the browser is public.

# Base URL of the PACTRA FastAPI service.
PACTRA_API_URL=http://127.0.0.1:8000

# Where `python -m services.attack_lab.run --out ...` and
# `python -m services.risk_engine.run --evaluate --out ...` write their JSON.
# Relative paths resolve from the repository root.
PACTRA_REPORTS_DIR=reports
